# Example user unit. Replace RUN_ID with an approved 32-hex run ID.
# This example is SSH-only. Bind an approved LAN address explicitly for LAN sharing.
[Unit]
Description=SC2 read-only spectator
After=sc2-harness-workbench.service
Wants=sc2-harness-workbench.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/sc2-harness
ExecStart=%h/projects/sc2-harness/.venv/bin/python -m sc2_viewer --host 127.0.0.1 --port 8903 --upstream http://127.0.0.1:18890 --allow-run-id RUN_ID --default-run-id RUN_ID
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
